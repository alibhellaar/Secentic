# Copy to .env and adjust.

# Required. SQLite works out of the box. For PostgreSQL use e.g.
# postgresql+psycopg://secentic:secentic@localhost:5432/secentic
DATABASE_URL=sqlite:///./secentic.db

# Bearer token for control-plane (admin) endpoints: a random value of at least 16 characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Admin endpoints refuse every request while this is empty or too short.
SECENTIC_ADMIN_TOKEN=
